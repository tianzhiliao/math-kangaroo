# Root environment file for local development.
# Copy to .env and replace placeholder values as needed.

# Required for AI explanation and TTS.
OPENAI_API_KEY=your_openai_api_key_here

# Used by Next.js proxy routes. Defaults to FastAPI on localhost in dev.
FASTAPI_BASE_URL=http://127.0.0.1:8000

# Optional override for the runtime dataset location.
# Leave empty to use the repository's release-data/ directory.
RELEASE_DATA_PATH=

# Optional FastAPI cache location.
API_CACHE_DIR=/tmp/math-api-cache

# Optional model and cache tuning.
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
OPENAI_EXPLANATION_MODEL=gpt-5.4
TTS_CACHE_TTL_SECONDS=86400
TTS_CACHE_MAX_ITEMS=500
