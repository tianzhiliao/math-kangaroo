# Required for working stem audio and a healthy backend.
OPENAI_API_KEY=your_openai_api_key

# Optional OpenAI TTS overrides.
TTS_MODEL=tts-1
TTS_VOICE=shimmer
TTS_RESPONSE_FORMAT=wav
TTS_TIMEOUT_SECONDS=45

# Optional path overrides.
# Use paths relative to the repository root if you start uvicorn from this directory.
EXAM_DATA_DIR=frontend/public/data
TTS_CACHE_DIR=.cache/tts
FRONTEND_DIST_DIR=frontend/dist
